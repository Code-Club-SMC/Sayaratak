# ==========================================
# SAYARATAK BACKEND API — ENVIRONMENT CONFIG
# ==========================================

# 1. DATABASE (Auto-provided by Railway when PostgreSQL is linked)
# Make sure PostGIS is enabled: run "CREATE EXTENSION IF NOT EXISTS postgis;"
DATABASE_URL=postgresql://postgres:password@host:5432/sayaratak

# 2. SERVER & BETTER-AUTH
PORT=8000
BETTER_AUTH_SECRET=generate_with_openssl_rand_hex_32
# The public HTTPS URL where this API is hosted (e.g. https://api.sayaratak.com or Railway URL)
BETTER_AUTH_URL=https://api.sayaratak.com
CLIENT_URL=https://sayaratak.com

# 3. ADMIN BOOTSTRAP SECRET
# Secret token used to hit /api/v1/admin/create-first-admin
ADMIN_CREATE_SECRET=replace_with_a_long_random_secret_token

# 4. CLOUDINARY (Media & Car Photos Uploads)
CLOUDINARY_CLOUD_NAME=sayaratak
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. FIREBASE CLOUD MESSAGING (Mobile Push Notifications)
# Stringified JSON of your Firebase Admin Service Account
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sayaratak-..."}

# 6. TRANSACTIONAL EMAIL (Nodemailer for password resets & verification)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_smtp_key

# 7. SOCIAL OAUTH (Optional for initial mobile testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
